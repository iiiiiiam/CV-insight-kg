  "components": {
    "schemas": {
      "BatchInput": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "c-graph/1.0",
            "title": "Contract Version"
          },
          "batch_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "title": "Batch Id"
          },
          "source_batch_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Batch Id"
          },
          "schema_version": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Schema Version"
          },
          "vocabulary_version": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Vocabulary Version"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "reviewed_export",
              "developer_fixture"
            ],
            "title": "Provenance"
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/Entity"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Entities"
          },
          "relations": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array",
            "maxItems": 30000,
            "title": "Relations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contract_version",
          "batch_id",
          "source_batch_id",
          "schema_version",
          "vocabulary_version",
          "provenance",
          "entities",
          "relations"
        ],
        "title": "BatchInput"
      },
      "Entity": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "paper",
              "author",
              "institution",
              "topic",
              "method",
              "task",
              "dataset",
              "venue"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Name"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 1900.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "abstract": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Missing Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "updated_at"
        ],
        "title": "Entity"
      },
      "Evidence": {
        "properties": {
          "paper_id": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Paper Id"
